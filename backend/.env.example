# --- Server ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# --- Logging ---
LOG_LEVEL=debug

# --- CORS ---
# Comma-separated list of origins allowed to call the API and connect to the WS.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/multicoder?schema=public

# --- ShareDB Persistence ---
# Where live room documents are stored. Options:
#   "postgres" — default; persists to DATABASE_URL (run `npx prisma migrate dev` first)
#   "memory"   — throwaway in-memory store, wiped on every backend restart
# Production always uses postgres. TLS is skipped for localhost URLs and for
# URLs with sslmode=disable (e.g. the docker-compose Postgres).
SHAREDB_STORAGE=postgres

# --- Frontend ---
# Origin of the React app. Used as the post-OAuth redirect target.
FRONTEND_URL=http://localhost:5173

# --- Auth: JWT ---
# 32+ character random string. Rotate to invalidate every session.
JWT_SECRET=<your-jwt-secret>
# JWT lifetime; accepts vercel ms format (e.g. 7d, 1h, 30m).
JWT_EXPIRES_IN=7d

# --- Auth: GitHub OAuth ---
# Create one at https://github.com/settings/developers (New OAuth App).
# Set the Authorization callback URL to OAUTH_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback

# --- Code execution (Piston) ---
# Self-hosted Piston from docker-compose. First container start installs runtimes (~60s).
PISTON_BASE_URL=http://localhost:2000/api/v2

# --- AI review ---
# Provider id selects which adapter the AI review service uses.
# Currently shipped adapters: "gemini" (free tier via Google AI Studio).
AI_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Free-tier-friendly Gemini model. `gemini-flash-latest` auto-tracks the
# current stable flash model so this won't rot when versions deprecate.
GEMINI_MODEL=gemini-flash-latest
